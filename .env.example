# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: These are prefixed with NEXT_PUBLIC_ because they're used in the browser.
# The anon key is safe to expose - Row Level Security protects your data.

# AeroDataBox Flight API (via RapidAPI)
# Get your key from: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=your-rapidapi-key-here

# Google OAuth (for Gmail sync - M4)
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OpenAI API (for email parsing - M4)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Mapbox (for flight map visualization - M5)
# Get from: https://www.mapbox.com/ (free tier: 50k loads/month)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
